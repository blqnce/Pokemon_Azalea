    "lines" : [ {
      "type" : "expression",
      "expression" : "'Ah cierto, tengo que contarte sobre el gimnasio jeje'"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Últimamente necesitamos recursos, así que para llegar hasta el líder no tendrás que pelear'"
