  "(q.player.data.hornacis_defeated >= 1) ? q.dialogue.close();"],"speakers":{"npc":{"name":{"type":"expression","expression":"q.npc.name"},"face":"q.npc.face()"},"player":{"name":{"type":"expression","expression":"q.player.username"},"face":"q.player.face()"}},"pages":[{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Hey'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'No suelo ver gente por aquí'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Soy el último sobreviviente de mi tribu'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Todos los monos de fuego murieron porque se cayeron a la lava'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'o sobreviví porque confundí una poción de resistencia contra el fuego con un jugo de naranja'"}]},{"id":"despedida","speaker":"npc","lines":[{"type":"expression","expression":"'Pero, ahora que sabes mi secreto, tendré que derrotarte'"}],"input":"q.dialogue.close(); v.battle = q.npc.start_battle(q.player);"},{"id":"on_cooldown","speaker":"npc","lines":[{"type":"expression","expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"}]}]}