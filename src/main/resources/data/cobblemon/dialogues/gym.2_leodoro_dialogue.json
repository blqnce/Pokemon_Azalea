{
  "initializationAction":[
    "(q.player.data.gym2_defeated < 3) ? q.dialogue.set_page('req-unmet');",
    "(q.player.data.gym2_defeated >= 3) ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.leodoro_defeated >= 1) ? q.dialogue.set_page('Dialogo27');"
  ],
  "speakers":{
    "npc":{
      "name":{
        "type":"expression",
        "expression":"q.npc.name"
      },
      "face":"q.npc.face()"
    },
    "player":{
      "name":{
        "type":"expression",
        "expression":"q.player.username"
      },
      "face":"q.player.face()"
    }
  },
  "pages":[
    {
      "id":"req-unmet",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Debes luchar contra los entrenadores del gimnasio antes de luchar contra mi, te espero.'"
        }
      ],
      "input" : "q.dialogue.close();"
    },
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Bienvenido a mi gimnasio: la Central Eléctrica de la ciudad.'"
        }
      ]
    },
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'A diferencia de otros lugares, para llegar hasta aquí has debido usar tu inteligencia. Y viendo que lo lograste, espero que seas digno de enfrentarme.'"
        }
      ]
    },
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Pero no te equivoques… no soy un rival sencillo. Este será un combate arduo para ti.'"
        }
      ]
    },
    {
      "id":"Pelea",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Adelante. Demuéstrame tu valía.'"
        }
      ],
      "input":{
        "type":"option",
        "vertical":false,
        "options":[
          {
            "text":"¡Vamos!",
            "value":"battle",
            "action":[
              "q.dialogue.close();",
              "v.battle = q.npc.start_battle(q.player);"
            ]
          },
          {
            "text":"Más tarde",
            "value":"no",
            "action":[
              "q.dialogue.set_page('despedida')"
            ]
          }
        ]
      }
    },
    {
      "id":"despedida",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Es una decisión prudente.  Prepárate correctamente.  Cuando regreses, no te concederé ventajas.'"
        }
      ],
      "input":"q.dialogue.close();"
    },
    {
      "id":"Dialogo27",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Si todos entrenaran como tú, este lugar sería muy distinto.'"
        }
      ],
      "input":"q.dialogue.close();"
    }
  ]
}