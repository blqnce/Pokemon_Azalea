{
  "initializationAction":[
    "(q.player.data.mago_defeated < 1) ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.mago_defeated >= 1) ? q.dialogue.set_page('Ganado');"
  ],
  "speakers":{
    "npc":{
      "name":{
        "type":"expression",
        "expression":"q.npc.name"
      },
      "face":"q.npc.face()"
    },
    "player":{
      "name":{
        "type":"expression",
        "expression":"q.player.username"
      },
      "face":"q.player.face()"
    }
  },
  "pages":[
    {
      "id": "Ganado",
      "speaker": "npc",
      "lines": ["Felicidades por la victoria, continúa con tu aventura."],
      "input": "q.dialogue.close();"
    },
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Vienes a medirte al gimnasio? '"
        }
      ]
    },
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'No tengo muchas ganas de pelear ahora, pero se supone que debo aceptar el combate... '"
        }
      ]
    },
    {
      "id":"Pelea",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Terminemos esto de una vez. '"
        }
      ],
      "input":{
        "type":"option",
        "vertical":false,
        "options":[
          {
            "text":"Estoy listo ",
            "value":"battle",
            "action":[
              "q.dialogue.close();",
              "v.battle = q.npc.start_battle(q.player);"
            ]
          },
          {
            "text":"Más tarde ",
            "value":"no",
            "action":[
              "q.dialogue.set_page('despedida')"
            ]
          }
        ]
      }
    },
    {
      "id":"despedida",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'No creas que te voy a estar esperando, si me duermo no me despiertes. '"
        }
      ],
      "input":"q.dialogue.close();"
    },
    {
      "id":"on_cooldown",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"
        }
      ]
    }
  ]
}