    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Hola. Soy Pika, un gusto. '"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Ahora mismo estoy ocupado cuidando a los Pokémon, como ves. '"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
