{
  "initializationAction" : [
    "(q.player.data.pika_spawn_hablado < 1) ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.pika_spawn_hablado >= 1) ? q.dialogue.set_page('Dialogo2');"
  ],
  "speakers" : {
    "npc" : {
