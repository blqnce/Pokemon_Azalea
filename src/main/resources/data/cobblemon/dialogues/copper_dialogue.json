{
  "initializationAction" : [
    "(q.player.data.elite4_defeated < 4) ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.elite4_defeated >= 4) ? q.dialogue.set_page('Dialogo3');"
  ],
  "speakers" : {
    "npc" : {
      "name" : {
