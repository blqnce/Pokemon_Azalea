      },
      "face" : "q.player.face()"
    }
  },
  "pages" : [ {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Bienvenido al desafío del Alto Mando.'"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Para poder enfrentarte al Campeón y disputar el título, deberás derrotar primero a los cuatro miembros del Alto Mando, cada uno maestro de su elemento: Hielo, Dragón, Lucha y Fantasma.'"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Para enfrentarlos, dirígete a cada habitación y activa el botón correspondiente.'"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Una vez completado el desafío, regresa y habla conmigo.'"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Entonces te enviaré al área donde se encuentra el Campeón.'"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Ten en cuenta que, para llevar a cabo el duelo final, deberás coordinar previamente un horario con él.'"
    } ],
    "input" : "q.close.dialogue()"
    
  }, {
    "id" : "Dialogo3",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Felicidades por haber derrotado al Alto Mando.'"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'¿Deseas que te envíe ahora al Salón de la Fama, donde podrás llevar a cabo el duelo final?'"
    } ],
    "input":{
      "type":"option",
      "vertical":false,
      "options":[
        {
          "text":"Si",
          "value":"si",
