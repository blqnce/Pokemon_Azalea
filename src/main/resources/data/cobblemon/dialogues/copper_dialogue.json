            "q.dialogue.close(); q.run_command('execute in azalea:forsaken_land_of_the_gods run tp '+ q.player.username + ' -66 74 -76 90 0');"
          ]
        },
        {
          "text":"No",
          "value":"no",
          "action":[

            "q.dialogue.close();"

          ]
        }
      ]
    }
    
  }

  ]
