{"initializationAction":["q.npc.config.toggle_battle_cooldown && q.run_script('cobblemon:cooldown_check') ? q.dialogue.set_page('on_cooldown');"],"speakers":{"npc":{"name":{"type":"expression","expression":"q.npc.name"},"face":"q.npc.face()"},"player":{"name":{"type":"expression","expression":"q.player.username"},"face":"q.player.face()"}},"pages":[{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Supongo que hay muchas cosas extrañas en esta isla.'"}]},{"id":"despedida","speaker":"npc","lines":[{"type":"expression","expression":"'¿No es extraño que se haya generado esta cueva en medio de una montaña?'"}],"input":"q.dialogue.close(); v.battle = q.npc.start_battle(q.player);"},{"id":"on_cooldown","speaker":"npc","lines":[{"type":"expression","expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"}]}]}