{
  "initializationAction":[
    "(q.player.data.raiden_defeated < 1)  ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.raiden_defeated >= 1)  ? q.dialogue.set_page('Dialogo3');"
  ],
  "speakers":{
    "npc":{
      "name":{
        "type":"expression",
        "expression":"q.npc.name"
      },
      "face":"q.npc.face()"
    },
    "player":{
      "name":{
        "type":"expression",
        "expression":"q.player.username"
      },
      "face":"q.player.face()"
    }
  },
  "pages":[
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Soy Raiden, alto mando y maestro del combate.'"
        }
      ]
    },
    {
      "id":"despedida",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Aquí se mide el espíritu. No me decepciones.'"
        }
      ],
      "input":"q.dialogue.close(); v.battle = q.npc.start_battle(q.player);"
    },
    {
      "id":"Dialogo3",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Sigue así. No pierdas nunca ese fuego, tu cuerpo y tu espíritu están en equilibrio.'"
        }
      ]
    }
  ]
}