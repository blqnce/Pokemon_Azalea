  "(q.player.data.chano_defeated >= 1) ? q.dialogue.close();"],"speakers":{"npc":{"name":{"type":"expression","expression":"q.npc.name"},"face":"q.npc.face()"},"player":{"name":{"type":"expression","expression":"q.player.username"},"face":"q.player.face()"}},"pages":[{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Los pokémones de tipo bicho suelen estar infravalorados'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'La gente los subestima'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Yo dediqué toda mi vida a perfeccionar su poder'"}]},{"id":"despedida","speaker":"npc","lines":[{"type":"expression","expression":"'¡Demostraré que los bichos son los más fuertes!'"}],"input":"q.dialogue.close(); v.battle = q.npc.start_battle(q.player);"},{"id":"on_cooldown","speaker":"npc","lines":[{"type":"expression","expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"}]}]}