{"initializationAction":["q.npc.config.toggle_battle_cooldown && q.run_script('cobblemon:cooldown_check') ? q.dialogue.set_page('on_cooldown');"],"speakers":{"npc":{"name":{"type":"expression","expression":"q.npc.name"},"face":"q.npc.face()"},"player":{"name":{"type":"expression","expression":"q.player.username"},"face":"q.player.face()"}},"pages":[{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Se extingió porque se cayeron todos a la lava'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Encontramos varios fósiles suyos'"}]},{"id":"despedida","speaker":"npc","lines":[{"type":"expression","expression":"'En esta cueva solía vivir una tribu de monos'"}],"input":"q.dialogue.close(); v.battle = q.npc.start_battle(q.player);"},{"id":"on_cooldown","speaker":"npc","lines":[{"type":"expression","expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"}]}]}