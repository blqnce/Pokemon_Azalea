{
  "initializationAction":[
    "(q.player.data.guerrero_eustaquio < 1) ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.guerrero_eustaquio >= 1) ? q.dialogue.set_page('Pelea');" ,
    "q.npc.config.toggle_battle_cooldown && q.run_script('cobblemon:cooldown_check') ? q.dialogue.set_page('on_cooldown');"
  ],
  "speakers":{
    "npc":{
      "name":{
        "type":"expression",
        "expression":"q.npc.name"
      },
      "face":"q.npc.face()"
    },
    "player":{
      "name":{
        "type":"expression",
        "expression":"q.player.username"
      },
      "face":"q.player.face()"
    }
  },
  "pages":[
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Veo que tienes agallas'"
        }
      ]
    },
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Te daré un casco para que puedas defenderte ante los ataques.'"
        }
      ],
      "input": "q.run_command('give ' + q.player.username + ' cobblemon:rocky_helmet'); q.player.data.guerrero_eustaquio = 1; q.player.save_data(); q.dialogue.set_page('Dialogo3');"
    },
    {
      "id":"Dialogo3",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Cuida siempre tus espaldas...'"
        }
      ]
    },
    {
      "id":"Pelea",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Un verdadero guerrero no se quita el casco ni para descansar. Siempre estoy alerta'"
        }
      ],
      "input":{
        "type":"option",
        "vertical":false,
        "options":[
          {
            "text":"Estás loco",
            "value":"battle",
            "action":[
              "q.dialogue.close();",
              "v.battle = q.npc.start_battle(q.player, 'double');"
            ]
          },
          {
            "text":"Coincido",
            "value":"no",
            "action":[
              "q.dialogue.set_page('despedida')"
            ]
          }
        ]
      }
    },
    {
      "id":"despedida",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Mejor sigue tu camino, antes de que me hagas enojar.'"
        }
      ],
      "input":"q.dialogue.close();"
    },
    {
      "id":"on_cooldown",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"
        }
      ]
    }
  ]
}