{"initializationAction":["(q.player.data.tito_defeated < 1) ? q.dialogue.set_page('Dialogo');",
  "(q.player.data.tito_defeated >= 1) ? q.dialogue.close();"],"speakers":{"npc":{"name":{"type":"expression","expression":"q.npc.name"},"face":"q.npc.face()"},"player":{"name":{"type":"expression","expression":"q.player.username"},"face":"q.player.face()"}},"pages":[{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'\"¿Tito, decime en que ruta capturaste esos pokémones para no ir?\"'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Bueno, va a ser dificil porque los capturé...'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Ah, hola, le estaba respondiendo a un diglett del chat'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Ah, mira, justo tu progenitora escribió que te tengo que ganar un combate'"}]},{"id":"despedida","speaker":"npc","lines":[{"type":"expression","expression":"'Luigi, il combattere por favore!'"}],"input":"q.dialogue.close(); v.battle = q.npc.start_battle(q.player);"},{"id":"on_cooldown","speaker":"npc","lines":[{"type":"expression","expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"}]}]}