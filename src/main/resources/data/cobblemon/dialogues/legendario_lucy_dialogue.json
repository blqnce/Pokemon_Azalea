  "(q.player.data.lucy_defeated >= 1) ? q.dialogue.close();"],"speakers":{"npc":{"name":{"type":"expression","expression":"q.npc.name"},"face":"q.npc.face()"},"player":{"name":{"type":"expression","expression":"q.player.username"},"face":"q.player.face()"}},"pages":[{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Holis'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Veo que también te gusta explorar'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Yo llevo algunos años explorando el mundo, aunque ahora volví a la isla'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'En casa siempre me dieron todo pero hay cosas que el dinero no puede comprar'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Libertad'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Diversión'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'¿Mi ausencia dejó consecuencias?'"}]},{"id":"Dialogo","speaker":"npc","lines":[{"type":"expression","expression":"'Probablemente, pero...'"}]},{"id":"despedida","speaker":"npc","lines":[{"type":"expression","expression":"'Es el precio que decidí pagar'"}],"input":"q.dialogue.close(); v.battle = q.npc.start_battle(q.player);"},{"id":"on_cooldown","speaker":"npc","lines":[{"type":"expression","expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"}]}]}