{
  "initializationAction":[
    "q.npc.config.toggle_battle_cooldown && q.run_script('cobblemon:cooldown_check') ? q.dialogue.set_page('on_cooldown');"
  ],
  "speakers":{
    "npc":{
      "name":{
        "type":"expression",
        "expression":"q.npc.name"
      },
      "face":"q.npc.face()"
    },
    "player":{
      "name":{
        "type":"expression",
        "expression":"q.player.username"
      },
      "face":"q.player.face()"
    }
  },
  "pages":[
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Estoy pescando comida para llevar a mi tribu.'"
        }
      ]
    },
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'La regla número 1 de los monos es rendirse y no defenderse.'"
        }
      ]
    },
    {
      "id":"Pelea",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Esto es todo lo que tengo.'"
        }
      ],
      "input":{
        "type":"option",
        "vertical":false,
        "options":[
          {
            "text":"Robar",
            "value":"battle",
            "action":[
              "q.dialogue.close();",
              "v.battle = q.npc.start_battle(q.player);"
            ]
          },
          {
            "text":"Dejar",
            "value":"no",
            "action":[
              "q.dialogue.set_page('despedida')"
            ]
          }
        ]
      }
    },
    {
      "id":"despedida",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'La vida del mono pescador es muy complicada.'"
        }
      ],
      "input":"q.dialogue.close();"
    },
    {
      "id":"on_cooldown",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"
        }
      ]
    }
  ]
}