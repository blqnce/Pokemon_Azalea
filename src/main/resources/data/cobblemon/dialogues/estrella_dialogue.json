{
  "initializationAction":[

    "(q.player.data.estrella_defeated < 1) ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.estrella_defeated >= 1) ? q.dialogue.set_page('Ganado');"

  ],
  "speakers":{
    "npc":{
      "name":{
        "type":"expression",
        "expression":"q.npc.name"
      },
      "face":"q.npc.face()"
    },
    "player":{
      "name":{
        "type":"expression",
        "expression":"q.player.username"
      },
      "face":"q.player.face()"
    }
  },
  "pages":[
    {
      "id": "Ganado",
      "speaker": "npc",
      "lines": ["Felicidades por la victoria, continúa con tu aventura."],
      "input": "q.dialogue.close();"
    },
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Me presento… la Estrella, para usted.'"
        }
      ]
    },
    {
      "id":"Pelea",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'¿Acaso deseas demostrar tu capacidad? Ten por seguro que no te lo pondré fácil. ¡Alabado sea el Loco!'"
        }
      ],
      "input":{
        "type":"option",
        "vertical":false,
        "options":[
          {
            "text":"Estoy listo",
            "value":"battle",
            "action":[
              "q.dialogue.close();",
              "v.battle = q.npc.start_battle(q.player);"
            ]
          },
          {
            "text":"Más tarde",
            "value":"no",
            "action":[
              "q.dialogue.set_page('despedida')"
            ]
          }
        ]
      }
    },
    {
      "id":"despedida",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Veo que aún tienes dudas. Estaré aquí, esperando.'"
        }
      ],
      "input":"q.dialogue.close();"
    },
    {
      "id":"on_cooldown",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"
        }
      ]
    }
  ]
}