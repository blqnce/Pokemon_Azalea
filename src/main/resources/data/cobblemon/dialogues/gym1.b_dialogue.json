{
  "initializationAction":[
    "(q.player.data.qilangos_defeated < 1)  ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.qilangos_defeated >= 1)  ? q.dialogue.set_page('Dialogo3');"
  ],
  "speakers":{
    "npc":{
      "name":{
        "type":"expression",
        "expression":"q.npc.name"
      },
      "face":"q.npc.face()"
    },
    "player":{
      "name":{
        "type":"expression",
        "expression":"q.player.username"
      },
      "face":"q.player.face()"
    }
  },
  "pages":[
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Vamos!'"
        }
      ],
      "input":"q.dialogue.close(); v.battle = q.npc.start_battle(q.player);"
    },
    {
      "id":"Dialogo3",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Esto solo fue el comienzo. Ahora verás lo que es el poder del agua.'"
        }
      ]
    }
  ]
}