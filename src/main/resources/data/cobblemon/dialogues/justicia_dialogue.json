{
  "initializationAction":[
    "(q.player.data.justicia_defeated < 1) ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.justicia_defeated >= 1) ? q.dialogue.set_page('Ganado');"
  ],
  "speakers":{
    "npc":{
      "name":{
        "type":"expression",
        "expression":"q.npc.name"
      },
      "face":"q.npc.face()"
    },
    "player":{
      "name":{
        "type":"expression",
        "expression":"q.player.username"
      },
      "face":"q.player.face()"
    }
  },
  "pages":[
    {
      "id": "Ganado",
      "speaker": "npc",
      "lines": ["Felicidades por la victoria, continúa con tu aventura."],
      "input": "q.dialogue.close();"
    },
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Veo que tienes algo de nervios, pero es evidente tu confianza.'"
        }
      ]
    },
    {
      "id":"Pelea",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Enseñanos tu fuerza en este combate y demuestra ser digno de enfrentarle al loco. Alabado sea el loco!~ '"
        }
      ],
      "input":{
        "type":"option",
        "vertical":false,
        "options":[
          {
            "text":"Estoy listo",
            "value":"battle",
            "action":[
              "q.dialogue.close();",
              "v.battle = q.npc.start_battle(q.player);"
            ]
          },
          {
            "text":"Mas tarde",
            "value":"no",
            "action":[
              "q.dialogue.set_page('despedida')"
            ]
          }
        ]
      }
    },
    {
      "id":"despedida",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Puedo ver que necesitas preparar algo, pero tambien tu determinacion de volver aqui. Nos vemos luego~'"
        }
      ],
      "input":"q.dialogue.close();"
    },
    {
      "id":"on_cooldown",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Este npc le quedan ' + q.run_script('cobblemon:cooldown_remaining_time') + ' de cooldown'"
        }
      ]
    }
  ]
}