{
  "initializationAction" : [
    "(q.player.data.rebelde_carol < 1) ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.rebelde_carol >= 1) ? q.dialogue.set_page('Bloqueado');",
    "q.run_script('cobblemon:carol_trade')"
  ],
  "speakers" : {
    "npc" : {
      "name" : {
        "type" : "expression",
        "expression" : "q.npc.name"
      },
      "face" : "q.npc.face()"
    },
    "player" : {
      "name" : {
        "type" : "expression",
        "expression" : "q.player.username"
      },
      "face" : "q.player.face()"
    }
  },
  "pages" : [ {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Holis'"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Gracias por la hadita, vamos a hacer muchos polvos a partir suyo <3'"
    } ]
    
  }, {
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'Ahora te voy a pedir un Klefki'"
    } ]
    
  },{
    "id" : "Dialogo",
    "speaker" : "npc",
    "lines" : [ {
      "type" : "expression",
      "expression" : "'En caso de que tengas uno y le tengas mucho aprecio... te aconsejo traer otro'"
    } ],
    "input": {
      "type": "option",
      "vertical": false,
      "options": [
        {
          "text": {
            "type": "expression",
            "expression": "'Toma'"
          },
          "value": "trade",
          "action": [
            "q.run_script('cobblemon:execute_carol');",
            "q.dialogue.set_page('farewell');"
          ],
          "isSelectable": "(q.player.party.count_by_properties(q.npc.data.trade_request) >= 1)"
        },
        {
          "text": "Espera",
          "value": "cancel",
          "action": [
            "q.dialogue.close()"
          ]
        }
      ]
    }


  },
    {
      "id": "farewell",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "'Muchas gracias por tu patrocinio'"
        }
      ],
      "input": "q.dialogue.close(); q.run_command('execute in pokemonazalea:island run tp ' + q.player.username +' -93 55 476');"
    },
    {
      "id": "Bloqueado",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "'Te humillaron? Bueno sigue adelante'"
        }
      ],
      "input": "q.dialogue.close(); q.run_command('execute in pokemonazalea:island run tp ' + q.player.username +' -93 55 476');"
    }
  ]
}