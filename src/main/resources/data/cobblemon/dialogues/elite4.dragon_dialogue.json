{
  "initializationAction":[
    "(q.player.data.aurelion_defeated < 1)  ? q.dialogue.set_page('Dialogo');",
    "(q.player.data.aurelion_defeated >= 1)  ? q.dialogue.set_page('Dialogo3');"
  ],
  "speakers":{
    "npc":{
      "name":{
        "type":"expression",
        "expression":"q.npc.name"
      },
      "face":"q.npc.face()"
    },
    "player":{
      "name":{
        "type":"expression",
        "expression":"q.player.username"
      },
      "face":"q.player.face()"
    }
  },
  "pages":[
    {
      "id":"Dialogo",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Has llegado lejos, entrenador.  Soy Aurelion, maestro del tipo Dragón.'"
        }
      ]
    },
    {
      "id":"despedida",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Aquí no hay suerte… solo poder verdadero.'"
        }
      ],
      "input":"q.dialogue.close(); v.battle = q.npc.start_battle(q.player, 'double');"
    },
    {
      "id":"Dialogo3",
      "speaker":"npc",
      "lines":[
        {
          "type":"expression",
          "expression":"'Tu fuerza no es casualidad. Has luchado por cada paso.'"
        }
      ]
    }
  ]
}