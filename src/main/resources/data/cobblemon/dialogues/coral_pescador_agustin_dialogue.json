    "input": "q.run_command('give ' + q.player.username + ' cobblemon:heavy_duty_boots'); q.player.data.pescador_agustin = 1; q.player.save_data(); q.dialogue.set_page('Dialogo3');"
    
  }, {
    "id" : "Dialogo3",
